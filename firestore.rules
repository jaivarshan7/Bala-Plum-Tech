rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'OWNER';
    }

    function isEmployee() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'EMPLOYEE';
    }

    match /users/{userId} {
      allow read: if signedIn() && (userId == request.auth.uid || isOwner());
      allow create: if signedIn() && (userId == request.auth.uid || isOwner());
      allow update: if signedIn() && (userId == request.auth.uid || isOwner());
      allow delete: if false;
    }

    match /inventory/{itemId} {
      allow read: if signedIn();
      allow create: if signedIn() && (isOwner() || isEmployee());
      allow update: if signedIn() && (isOwner() || isEmployee());
      allow delete: if false;
    }

    match /inventoryTransactions/{transactionId} {
      allow read: if signedIn() && (isOwner() || isEmployee() || resource.data.userId == request.auth.uid);
      allow create: if signedIn() && (isOwner() || isEmployee());
      allow update: if false;
      allow delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isOwner());
      allow create: if signedIn() && (isOwner() || isEmployee());
      allow update: if signedIn() && (resource.data.userId == request.auth.uid || isOwner());
      allow delete: if false;
    }
  }
}
